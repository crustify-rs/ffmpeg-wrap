# Example <repo>/crustify/.gitignore.

.providers
tmp
.worktrees
rust/target
rust.bak

# Oracle extraction and deterministic caches. Target configs and ownership
# findings remain tracked.
oracle/codeql
oracle/.cache

# Campaign plans are tracked; execution logs are not.
campaigns/**/logs

# Deterministic safety scan output.
audit/unsafe.json

# Agentic UB transcripts, like campaign execution logs. The per-run
# usage.json stays tracked: accounting reads it.
audit/logs/*.log

# Machine-local dependency and binary paths.
cli-config.json

bak
stats.md
evaluation/**/manifests/
